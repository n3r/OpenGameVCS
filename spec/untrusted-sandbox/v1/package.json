{
  "name": "@opengamevcs/untrusted-sandbox-contract-v1",
  "version": "0.1.0",
  "description": "Candidate OpenGameVCS credential-free parser boundary contract",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./manifest.json": "./manifest.json",
    "./schemas/*": "./schemas/*",
    "./vectors/*": "./vectors/*",
    "./validate-spec": "./validate-spec.mjs",
    "./package.json": "./package.json"
  },
  "files": ["README.md", "manifest.json", "schemas", "scripts", "test/validate-spec.test.mjs", "vectors", "validate-spec.mjs"],
  "scripts": {
    "check": "node scripts/generate.mjs && node validate-spec.mjs",
    "check:predecessors": "node scripts/generate.mjs --verify-predecessors",
    "test": "npm run check && node --test test/validate-spec.test.mjs",
    "test:source": "npm run check:predecessors && npm test && node --test test/package-contract.test.mjs",
    "test:package": "npm pack --dry-run --json"
  },
  "engines": { "node": ">=22" }
}
