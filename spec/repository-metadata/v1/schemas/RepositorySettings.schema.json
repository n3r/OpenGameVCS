{"$id":"https://schemas.opengamevcs.dev/repository-metadata/v1/RepositorySettings.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"caseMode":{"enum":["case-sensitive","case-folded"]},"contentPolicyProfile":{"maxLength":328,"pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+/[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]{0,9}$","type":"string"},"pathProfile":{"maxLength":328,"pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+/[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]{0,9}$","type":"string"},"platformProfile":{"maxLength":328,"pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+/[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]{0,9}$","type":"string"},"repositoryFormat":{"const":"ogvcs.repository-format@1"},"requiredFeatures":{"items":{"maximum":65535,"minimum":0,"type":"integer"},"maxItems":128,"minItems":0,"type":"array","uniqueItems":true},"schemaVersion":{"const":"ogvcs.repository-metadata/repository-settings/v1"},"structuralLimits":{"additionalProperties":false,"properties":{"maxPathBytes":{"maximum":4096,"minimum":0,"type":"integer"},"maxPathSegments":{"maximum":256,"minimum":0,"type":"integer"},"maxSnapshotParents":{"maximum":8,"minimum":0,"type":"integer"},"maxTreeEntries":{"maximum":1000000,"minimum":0,"type":"integer"}},"required":["maxTreeEntries","maxPathBytes","maxPathSegments","maxSnapshotParents"],"type":"object"},"tenantBoundary":{"maxLength":36,"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","type":"string"}},"required":["schemaVersion","repositoryFormat","requiredFeatures","caseMode","pathProfile","platformProfile","contentPolicyProfile","structuralLimits","tenantBoundary"],"title":"RepositorySettings","type":"object","x-ogvcs-license":"MIT"}
