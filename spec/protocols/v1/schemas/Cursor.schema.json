{"$id":"https://schemas.opengamevcs.dev/protocol/v1/Cursor.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Opaque public cursor token; scope and position remain server-side and MAC-bound.","properties":{"token":{"description":"token","maxLength":1024,"minLength":16,"pattern":"^[A-Za-z0-9._~-]+$","type":"string","x-ogvcs-field-id":1,"x-ogvcs-fingerprint":false,"x-ogvcs-maxUtf8Bytes":1024,"x-ogvcs-sensitive":true}},"required":["token"],"title":"Cursor","type":"object","x-ogvcs-license":"MIT","x-ogvcs-message-code":11}