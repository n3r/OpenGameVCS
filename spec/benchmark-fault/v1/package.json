{
  "name": "@opengamevcs/benchmark-fault-contract-v1",
  "version": "1.0.0-rc.2",
  "description": "Normative OpenGameVCS benchmark, fault-driver, result, and conformance contract",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./manifest.json": "./manifest.json",
    "./profiles/*": "./profiles/*",
    "./registries/*": "./registries/*",
    "./schemas/*": "./schemas/*",
    "./thresholds/*": "./thresholds/*",
    "./vectors/*": "./vectors/*",
    "./package.json": "./package.json"
  },
  "files": [
    "docs",
    "profiles",
    "registries",
    "schemas",
    "thresholds",
    "vectors",
    "manifest.json",
    "validate-spec.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node source/generate.mjs",
    "check": "node source/generate.mjs --check && node validate-spec.mjs",
    "test": "node source/generate.mjs --check && node validate-spec.mjs && node --test test/*.test.mjs",
    "test:package": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=22"
  }
}
