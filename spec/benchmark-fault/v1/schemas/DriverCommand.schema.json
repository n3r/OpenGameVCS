{"$id":"https://schemas.opengamevcs.dev/benchmark-fault/v1/DriverCommand.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"id":{"$ref":"Common.schema.json#/$defs/id"},"idempotencyKey":{"maxLength":256,"minLength":16,"pattern":"^[A-Za-z0-9._~-]+$","type":"string","x-ogvcs-maxUtf8Bytes":256},"operation":{"enum":["negotiate","configure","reset-cache","start","run-task","arm-fault","check-invariants","stop"]},"payload":{"$ref":"Common.schema.json#/$defs/jsonValue"},"schemaVersion":{"const":"ogvcs.benchmark/driver-command/v1"},"version":{"maximum":65535,"minimum":1,"type":"integer"}},"required":["schemaVersion","id","version","operation","idempotencyKey","payload"],"title":"DriverCommand","type":"object","x-ogvcs-license":"MIT"}