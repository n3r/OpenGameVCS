        "workspace": { "endpoint": "https://workspace.example", "profile": "workspace", "output": "human" },
        "userProfile": { "endpoint": "https://user.example", "profile": "user", "output": "json" },
        "systemDefault": { "endpoint": "https://system.example", "profile": "system", "output": "human" }
      },
      "expected": {
        "endpoint": { "value": "https://flag.example", "source": "flag" },
        "profile": { "value": "environment", "source": "environment" },
        "output": { "value": "json", "source": "flag" },
        "code": "CONFIG_RESOLVED"
      }
    },
