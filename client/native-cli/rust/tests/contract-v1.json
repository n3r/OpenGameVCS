  "cases": [
    {
      "id": "config-precedence-source-report",
      "kind": "configuration",
      "input": {
        "flags": { "endpoint": "https://flag.example", "output": "json" },
        "environment": { "endpoint": "https://environment.example", "profile": "environment" },
        "workspace": { "endpoint": "https://workspace.example", "profile": "workspace", "output": "human" },
        "userProfile": { "endpoint": "https://user.example", "profile": "user", "output": "json" },
        "systemDefault": { "endpoint": "https://system.example", "profile": "system", "output": "human" }
      },
      "expected": {
        "endpoint": { "value": "https://flag.example", "source": "flag" },
        "profile": { "value": "environment", "source": "environment" },
        "output": { "value": "json", "source": "flag" },
        "code": "CONFIG_RESOLVED"
      }
    },
    {
      "id": "secret-like-config-rejected",
      "kind": "configuration",
      "input": { "configuration": { "endpoint": "https://safe.example", "token": "not-for-output" } },
      "expected": { "exitClass": "input", "code": "CONFIG_INVALID", "forbidden": "not-for-output" }
    },
    {
      "id": "raw-declaration-rejected",
      "kind": "workspace",
      "input": {
        "repositoryDeclarationDigest": "raw-declaration",
        "branchDeclarationDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "baselineDeclarationDigest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "specDeclarationDigest": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      },
      "expected": { "exitClass": "input", "code": "INPUT_INVALID", "workspacePublished": false }
    },
    {
      "id": "cancel-after-control-publish",
      "kind": "workspace",
      "input": { "cancellationPoint": "after-control-publish" },
      "expected": {
        "exitClass": "cancelled",
        "code": "OPERATION_CANCELLED",
        "workspacePublished": true,
        "markerState": "initializing",
        "remoteDurableState": "unchanged",
        "nextOperation": "workspace recover"
      }
    },
    {
      "id": "noninteractive-provider-unavailable",
      "kind": "credential",
      "input": { "providerStatus": "unavailable", "nonInteractive": true },
      "expected": {
        "exitClass": "interaction-required",
        "code": "AUTHENTICATION_REQUIRED",
        "credentialStatus": "unavailable",
        "prompted": false
      }
    },
    {
      "id": "diagnostic-redaction",
      "kind": "diagnostics",
      "input": {
        "root": "/private/workspaces/alice-project",
        "workspaceId": "wsl1.eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "endpoint": "https://service.example/api",
        "profile": "alice-profile",
        "repositoryDeclarationDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "branchDeclarationDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "baselineDeclarationDigest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "specDeclarationDigest": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "credentialStatus": "headless-required"
      },
      "expected": {
        "schema": "ogvcs.cli-workspace/diagnostic-preview/v1",
        "code": "DIAGNOSTICS_PREVIEW",
        "endpointScheme": "https",
        "credentialStatus": "headless-required",
        "redactionPolicy": "v1-no-paths-identities-or-secrets"
      }
    }
  ]
