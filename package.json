{
  "name": "opengamevcs",
  "version": "0.0.0",
  "private": true,
  "description": "OpenGameVCS implementation workspace",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "foundation/fixture-generator",
    "core/object-model/js",
    "core/chunking-manifest/js",
    "core/authz-contract/js",
    "core/identity-policy-audit/js",
    "core/paths-filesystem/js",
    "foundation/protocol-baseline/js",
    "foundation/protocol-baseline/adapters/js-independent",
    "foundation/protocol-baseline/bindings/typescript",
    "foundation/benchmark-fault-harness",
    "spec/authorization/v1",
    "spec/chunking-manifest/v1",
    "spec/identity-policy-audit/v1",
    "spec/path-filesystem/v1",
    "spec/protocols/v1",
    "spec/benchmark-fault/v1",
    "spec/repository-metadata/v1"
  ],
  "scripts": {
    "test": "npm run test --workspace @opengamevcs/fixture-generator && npm run test --workspace @opengamevcs/object-model && npm run test:chunking:spec && npm run test:chunking:js && npm run test:metadata:spec && npm run test:metadata && npm run test:identity:spec && npm run test:identity && npm run test --workspace @opengamevcs/authorization-contract && npm run test:authz:spec && npm run test:authz:ci-report && npm run test --workspace @opengamevcs/path-filesystem && npm run test:path:spec && npm run test:path:ci-report && npm run test:protocol:spec && npm run test:protocol && npm run test:protocol:adapter && npm run test:protocol:ci-report && npm run test:spec && npm run test:vectors && node --test prd/validate-roadmap.test.mjs && npm run test:object-model:ci-report && npm run test:benchmark:spec && npm run test:benchmark && npm run test:benchmark:ci-report",
    "test:authz": "npm run test --workspace @opengamevcs/authorization-contract",
    "test:authz:spec": "npm run test --workspace @opengamevcs/authorization-contract-v1",
    "test:authz:ci-report": "node --test tools/authorization-contract-report.test.mjs",
    "test:path": "npm run test --workspace @opengamevcs/path-filesystem",
    "test:path:spec": "npm run test --workspace @opengamevcs/path-contract-v1",
    "test:path:report": "node tools/path-filesystem-conformance-report.mjs --output artifacts/path-filesystem-conformance.json",
    "test:path:packed-report": "node tools/run-packed-path-filesystem-conformance.mjs --output artifacts/packed-path-filesystem-conformance",
    "test:path:ci-report": "node --test tools/path-filesystem-conformance-report.test.mjs tools/compare-path-filesystem-reports.test.mjs tools/path-filesystem-trace-audit.test.mjs tools/path-filesystem-workflow-policy.test.mjs",
    "test:chunking:js": "npm run test --workspace @opengamevcs/chunking-manifest",
    "test:chunking:spec": "npm run test --workspace @opengamevcs/chunking-manifest-contract-v1",
    "test:metadata:spec": "npm run test --workspace @opengamevcs/repository-metadata-contract-v1",
    "test:metadata": "node server/modules/repository-metadata/scripts/static-check.mjs && node server/modules/repository-metadata/scripts/service-report.mjs --check && node --test tools/repository-metadata-workflow-policy.test.mjs",
    "test:identity": "npm run test --workspace @opengamevcs/identity-policy-audit",
    "test:identity:spec": "npm run test --workspace @opengamevcs/identity-policy-audit-contract-v1",
    "test:protocol": "npm run test --workspace @opengamevcs/protocol-baseline",
    "test:protocol:adapter": "npm run check --workspace @opengamevcs/protocol-baseline-independent-adapter",
    "test:protocol:spec": "node foundation/protocol-baseline/codegen/generate.mjs --check && npm run check --workspace @opengamevcs/protocol-contract-v1 && node --test spec/protocols/v1/test/package-contract.test.mjs spec/protocols/v1/test/validate-spec.test.mjs",
    "test:protocol:report": "node tools/protocol-conformance-report.mjs --output artifacts/protocol-conformance",
    "test:protocol:packed-report": "node tools/run-packed-protocol-conformance.mjs --output artifacts/packed-protocol-conformance",
    "test:protocol:ci-report": "node --test tools/protocol-conformance-report.test.mjs tools/compare-protocol-conformance-reports.test.mjs tools/run-packed-protocol-conformance.test.mjs",
    "test:object-model:js": "npm run test --workspace @opengamevcs/object-model",
    "test:object-model:report": "node tools/object-model-conformance-report.mjs --output artifacts/object-model-conformance.json",
    "test:object-model:packed-report": "node tools/run-packed-object-model-conformance.mjs --output artifacts/packed-object-model-conformance",
    "test:object-model:ci-report": "node --test tools/object-model-conformance-report.test.mjs tools/compare-object-model-scale.test.mjs tools/object-model-workflow-policy.test.mjs",
    "test:vectors": "node tools/verify-reference-vectors.mjs && node --test tools/verify-reference-vectors.test.mjs",
    "test:spec": "node spec/repository-format/v1/validate-spec.mjs && node --test spec/repository-format/v1/validate-spec.test.mjs",
    "test:roadmap": "node prd/validate-roadmap.mjs && node --test prd/validate-roadmap.test.mjs",
    "test:fixture:scale": "npm run test:scale --workspace @opengamevcs/fixture-generator",
    "test:benchmark": "npm run test --workspace @opengamevcs/benchmark-fault-harness",
    "test:benchmark:spec": "npm run test --workspace @opengamevcs/benchmark-fault-contract-v1",
    "test:benchmark:report": "node tools/benchmark-fault-conformance-report.mjs --output artifacts/benchmark-fault-source --profile presubmit",
    "test:benchmark:packed-report": "node tools/run-packed-benchmark-fault-conformance.mjs --output artifacts/benchmark-fault-packed --profile presubmit",
    "test:benchmark:ci-report": "node --test tools/benchmark-fault-conformance-report.test.mjs tools/benchmark-fault-workflow-policy.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
