    "idPattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
    "idUtf8BytesMaximum": 63,
    "namespacePattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$",
    "namespaceUtf8BytesMaximum": 253,
    "textKey": "<namespace>/<id>@<major>"
  },
