{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opengamevcs.org/fixture/v2/GroupRelationships.schema.json",
  "title": "GroupRelationships",
  "description": "Canonical profile-specific group declarations stored in groups.json and embedded in the manifest.",
  "type": "array",
  "maxItems": 10000,
  "items": { "$ref": "#/$defs/group" },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "members"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "$ref": "#/$defs/name" },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/logicalPath" }
        },
        "negativeCase": { "enum": ["missing-sidecar", "duplicate-guid"] }
      }
    },
    "logicalPath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*/$)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
      "x-ogvcs-normalization": "NFC",
      "x-ogvcs-portable-relative-path": true
    },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" }
  }
}
