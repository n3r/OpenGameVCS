{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opengamevcs.org/fixture/v2/InventoryRecord.schema.json",
  "title": "InventoryRecord",
  "description": "One canonical record in inventory.ndjson for the semantic-v2 fixture contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "fileId", "index", "kind", "logicalPath", "mode", "role"],
  "properties": {
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/semanticContent" },
        { "$ref": "#/$defs/deterministicBinaryContent" },
        { "$ref": "#/$defs/largeRecipeContent" }
      ]
    },
    "fileId": { "$ref": "#/$defs/id128" },
    "group": { "$ref": "#/$defs/groupIdentity" },
    "index": { "type": "integer", "minimum": 0, "maximum": 9999999 },
    "kind": { "const": "file" },
    "logicalPath": { "$ref": "#/$defs/logicalPath" },
    "mode": { "enum": ["100644", "100755"] },
    "negativeCase": { "enum": ["missing-sidecar", "duplicate-guid"] },
    "role": { "$ref": "#/$defs/name" },
    "syntheticGuid": { "$ref": "#/$defs/id128" }
  },
  "$defs": {
    "contentStream": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9-]*(?:/[A-Za-z0-9._-]+)+$",
      "x-ogvcs-normalization": "NFC"
    },
    "deterministicBinaryContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "contentAlgorithm", "digest", "logicalBytes", "mediaType", "representation", "sourceIndex", "stream"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "contentAlgorithm": { "const": "ogvcs.fixture/content-aes-256-ctr/v2" },
        "digest": { "$ref": "#/$defs/sha256" },
        "logicalBytes": { "$ref": "#/$defs/logicalBytes" },
        "mediaType": { "const": "application/octet-stream" },
        "representation": { "const": "deterministic-binary" },
        "sourceIndex": { "type": "integer", "minimum": 0, "maximum": 9999999 },
        "stream": { "$ref": "#/$defs/contentStream" }
      }
    },
    "groupIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "$ref": "#/$defs/name" }
      }
    },
    "id128": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "largeRecipeContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "contentAlgorithm", "digest", "logicalBytes", "mediaType", "representation", "sourceIndex", "stream"],
      "properties": {
        "algorithm": { "const": "sha256-recipe-v2" },
        "contentAlgorithm": { "const": "ogvcs.fixture/content-aes-256-ctr/v2" },
        "digest": { "$ref": "#/$defs/sha256" },
        "logicalBytes": { "$ref": "#/$defs/logicalBytes" },
        "mediaType": { "const": "application/octet-stream" },
        "representation": { "const": "large-version-recipe" },
        "sourceIndex": { "const": 0 },
        "stream": { "$ref": "#/$defs/contentStream" }
      }
    },
    "logicalBytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
    "logicalPath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*/$)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
      "x-ogvcs-normalization": "NFC",
      "x-ogvcs-portable-relative-path": true
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 127,
      "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
    },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
    "semanticContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "contentAlgorithm", "digest", "logicalBytes", "mediaType", "representation", "sourceIndex", "stream", "version", "versions"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "contentAlgorithm": { "const": "ogvcs.fixture/semantic-artifact/v2" },
        "digest": { "$ref": "#/$defs/sha256" },
        "logicalBytes": { "$ref": "#/$defs/logicalBytes" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "representation": { "const": "semantic-v2" },
        "sourceIndex": { "type": "integer", "minimum": 0, "maximum": 9999999 },
        "stream": { "$ref": "#/$defs/contentStream" },
        "version": { "type": "integer", "minimum": 0, "maximum": 63 },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/semanticVersion" }
        }
      }
    },
    "semanticVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseVersion", "delta", "digest", "logicalBytes", "version"],
      "properties": {
        "baseVersion": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 63
        },
        "delta": { "enum": ["create", "structured-line-edit", "binary-region-replace"] },
        "digest": { "$ref": "#/$defs/sha256" },
        "logicalBytes": { "$ref": "#/$defs/logicalBytes" },
        "version": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
